class ExprStringNameSpace(_NamespaceSuggestMixin):
    def __init__(self, expr: Expr) -> None: ...

    def to_date(self, format: str | None = None, *, strict: bool = True, exact: bool = True, cache: bool = True) -> Expr: ...

    def to_datetime(self, format: str | None = None, *, time_unit: TimeUnit | None = None, time_zone: str | None = None, strict: bool = True, exact: bool = True, cache: bool = True, ambiguous: Ambiguous | Expr = "raise") -> Expr: ...

    def to_time(self, format: str | None = None, *, strict: bool = True, cache: bool = True) -> Expr: ...

    def strptime(self, dtype: PolarsTemporalType, format: str | None = None, *, strict: bool = True, exact: bool = True, cache: bool = True, ambiguous: Ambiguous | Expr = "raise") -> Expr: ...

    @unstable()
    def to_decimal(self, *, scale: int) -> Expr: ...

    def len_bytes(self) -> Expr: ...

    def len_chars(self) -> Expr: ...

    def to_uppercase(self) -> Expr: ...

    def to_lowercase(self) -> Expr: ...

    def to_titlecase(self) -> Expr: ...

    def strip_chars(self, characters: IntoExpr = None) -> Expr: ...

    def strip_chars_start(self, characters: IntoExpr = None) -> Expr: ...

    def strip_chars_end(self, characters: IntoExpr = None) -> Expr: ...

    def strip_prefix(self, prefix: IntoExpr) -> Expr: ...

    def strip_suffix(self, suffix: IntoExpr) -> Expr: ...

    def pad_start(self, length: int | IntoExprColumn, fill_char: str = " ") -> Expr: ...

    def pad_end(self, length: int | IntoExprColumn, fill_char: str = " ") -> Expr: ...

    def zfill(self, length: int | IntoExprColumn) -> Expr: ...

    def contains(self, pattern: str | Expr, *, literal: bool = False, strict: bool = True) -> Expr: ...

    def find(self, pattern: str | Expr, *, literal: bool = False, strict: bool = True) -> Expr: ...

    def ends_with(self, suffix: str | Expr) -> Expr: ...

    def starts_with(self, prefix: str | Expr) -> Expr: ...

    @removed_parameters(
        RemovedParameter(
            name="infer_schema_length", deprecated_in="1.33.0", removed_in="2.0"
        )
    )
    def json_decode(self, dtype: PolarsDataType | pl.DataTypeExpr) -> Expr: ...

    def json_path_match(self, json_path: IntoExprColumn) -> Expr: ...

    def decode(self, encoding: TransferEncoding, *, strict: bool = True) -> Expr: ...

    def encode(self, encoding: TransferEncoding) -> Expr: ...

    def extract(self, pattern: IntoExprColumn, group_index: int = 1) -> Expr: ...

    def extract_all(self, pattern: str | Expr) -> Expr: ...

    def extract_groups(self, pattern: str) -> Expr: ...

    def count_matches(self, pattern: str | Expr, *, literal: bool = False) -> Expr: ...

    def split(self, by: IntoExpr, *, inclusive: bool = False, literal: bool = True, strict: bool = True) -> Expr: ...

    def split_exact(self, by: IntoExpr, n: int, *, inclusive: bool = False) -> Expr: ...

    def splitn(self, by: IntoExpr, n: int) -> Expr: ...

    def replace(self, pattern: str | Expr, value: str | Expr, *, literal: bool = False, n: int = 1) -> Expr: ...

    def replace_all(self, pattern: str | Expr, value: str | Expr, *, literal: bool = False) -> Expr: ...

    def reverse(self) -> Expr: ...

    def slice(self, offset: int | IntoExprColumn, length: int | IntoExprColumn | None = None) -> Expr: ...

    def head(self, n: int | IntoExprColumn) -> Expr: ...

    def tail(self, n: int | IntoExprColumn) -> Expr: ...

    def to_integer(self, *, base: int | IntoExprColumn = 10, dtype: PolarsIntegerType = ..., strict: bool = True) -> Expr: ...

    def contains_any(self, patterns: IntoExpr, *, ascii_case_insensitive: bool = False) -> Expr: ...

    def replace_many(self, patterns: IntoExpr | Mapping[str, str], replace_with: IntoExpr | NoDefault = ..., *, ascii_case_insensitive: bool = False, leftmost: bool = False) -> Expr: ...

    @unstable()
    def extract_many(self, patterns: IntoExpr, *, ascii_case_insensitive: bool = False, overlapping: bool = False, leftmost: bool = False) -> Expr: ...

    @unstable()
    def find_many(self, patterns: IntoExpr, *, ascii_case_insensitive: bool = False, overlapping: bool = False, leftmost: bool = False) -> Expr: ...

    def join(self, delimiter: str = "", *, ignore_nulls: bool = True) -> Expr: ...

    def escape_regex(self) -> Expr: ...

    def normalize(self, form: UnicodeForm = "NFC") -> Expr: ...
