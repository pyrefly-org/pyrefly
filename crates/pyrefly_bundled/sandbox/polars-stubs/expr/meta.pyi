from __future__ import annotations
from typing import TYPE_CHECKING, Any, Literal, overload
import polars._reexport as pl
from polars._utils.expired import getattr_fallback, raise_for_removed_attributes
from polars._utils.serde import serialize_polars_object
from polars._utils.unstable import unstable
from polars._utils.various import display_dot_graph
from polars._utils.wrap import wrap_expr
from polars.exceptions import ComputeError
from io import IOBase
from pathlib import Path
from polars import Expr
from polars._typing import SchemaDict, SerializationFormat


class ExprMetaNameSpace:
    def __init__(self, expr: Expr) -> None: ...

    def __str__(self) -> str: ...

    def __repr__(self) -> str: ...

    def __hash__(self) -> int: ...

    def __eq__(self, other: ExprMetaNameSpace | Expr) -> bool: ...

    def __ne__(self, other: ExprMetaNameSpace | Expr) -> bool: ...

    def eq(self, other: ExprMetaNameSpace | Expr) -> bool: ...

    def ne(self, other: ExprMetaNameSpace | Expr) -> bool: ...

    def has_multiple_outputs(self) -> bool: ...

    def is_column(self) -> bool: ...

    def is_regex_projection(self) -> bool: ...

    def is_column_selection(self, *, allow_aliasing: bool = False) -> bool: ...

    def is_literal(self, *, allow_aliasing: bool = False) -> bool: ...

    @unstable()
    def is_scalar(self) -> bool: ...

    @unstable()
    def is_length_preserving(self) -> bool: ...

    @unstable()
    def is_known_length(self) -> bool: ...

    @unstable()
    def is_row_separable(self) -> bool: ...

    @overload
    def output_name(self, *, raise_if_undetermined: Literal[True] = True) -> str: ...

    @overload
    def output_name(self, *, raise_if_undetermined: Literal[False]) -> str | None: ...

    def pop(self, *, schema: SchemaDict | None = None) -> list[Expr]: ...

    def root_names(self) -> list[str]: ...

    def undo_aliases(self) -> Expr: ...

    def as_expression(self) -> Expr: ...

    def as_selector(self) -> pl.Selector: ...

    @overload
    def serialize(self, file: None = ..., *, format: Literal["binary"] = ...) -> bytes: ...

    @overload
    def serialize(self, file: None = ..., *, format: Literal["json"]) -> str: ...

    @overload
    def serialize(self, file: IOBase | str | Path, *, format: SerializationFormat = ...) -> None: ...

    @overload
    def tree_format(self, *, return_as_string: Literal[False] = ..., schema: None | SchemaDict = None) -> None: ...

    @overload
    def tree_format(self, *, return_as_string: Literal[True], schema: None | SchemaDict = None) -> str: ...

    def show_graph(self, *, show: bool = True, output_path: str | Path | None = None, raw_output: bool = False, figsize: tuple[float, float] = ..., schema: None | SchemaDict = None) -> str | None: ...
