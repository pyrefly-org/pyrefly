from __future__ import annotations
from typing import TYPE_CHECKING, Any
import polars._reexport as pl
import polars.functions as F
from polars._utils.expired import getattr_fallback, raise_for_removed_attributes
from polars._utils.unstable import unstable
from polars._utils.various import NO_DEFAULT, _NamespaceSuggestMixin
from polars._utils.wrap import wrap_s
from polars.datatypes import Int64
from polars.datatypes.classes import Datetime
from polars.datatypes.constants import N_INFER_DEFAULT
from polars.series.utils import expr_dispatch
from collections.abc import Mapping
from polars import Expr, Series
from polars._plr import PySeries
from polars._typing import (
        Ambiguous,
        IntoExpr,
        IntoExprColumn,
        PolarsDataType,
        PolarsIntegerType,
        PolarsTemporalType,
        TimeUnit,
        TransferEncoding,
        UnicodeForm,
    )
from polars._utils.various import NoDefault


@expr_dispatch
class StringNameSpace(_NamespaceSuggestMixin):
    def __init__(self, series: Series) -> None: ...

    def to_date(self, format: str | None = None, *, strict: bool = True, exact: bool = True, cache: bool = True) -> Series: ...

    def to_datetime(self, format: str | None = None, *, time_unit: TimeUnit | None = None, time_zone: str | None = None, strict: bool = True, exact: bool = True, cache: bool = True, ambiguous: Ambiguous | pl.Series = "raise") -> pl.Series: ...

    def to_time(self, format: str | None = None, *, strict: bool = True, cache: bool = True) -> Series: ...

    def strptime(self, dtype: PolarsTemporalType, format: str | None = None, *, strict: bool = True, exact: bool = True, cache: bool = True, ambiguous: Ambiguous | Series = "raise") -> Series: ...

    def to_decimal(self, *, inference_length: int = 100, scale: int | None = None) -> Series: ...

    def len_bytes(self) -> Series: ...

    def len_chars(self) -> Series: ...

    def contains(self, pattern: str | Expr, *, literal: bool = False, strict: bool = True) -> Series: ...

    def find(self, pattern: str | Expr, *, literal: bool = False, strict: bool = True) -> Series: ...

    def ends_with(self, suffix: str | Expr | None) -> Series: ...

    def starts_with(self, prefix: str | Expr) -> Series: ...

    def decode(self, encoding: TransferEncoding, *, strict: bool = True) -> Series: ...

    def encode(self, encoding: TransferEncoding) -> Series: ...

    def json_decode(self, dtype: PolarsDataType | None = None, *, infer_schema_length: int | None = ...) -> Series: ...

    def json_path_match(self, json_path: IntoExprColumn) -> Series: ...

    def extract(self, pattern: IntoExprColumn, group_index: int = 1) -> Series: ...

    def extract_all(self, pattern: str | Series) -> Series: ...

    def extract_groups(self, pattern: str) -> Series: ...

    def count_matches(self, pattern: str | Series, *, literal: bool = False) -> Series: ...

    def split(self, by: IntoExpr, *, inclusive: bool = False) -> Series: ...

    def split_exact(self, by: IntoExpr, n: int, *, inclusive: bool = False) -> Series: ...

    def splitn(self, by: IntoExpr, n: int) -> Series: ...

    def replace(self, pattern: str, value: str, *, literal: bool = False, n: int = 1) -> Series: ...

    def replace_all(self, pattern: str, value: str, *, literal: bool = False) -> Series: ...

    def strip_chars(self, characters: IntoExpr = None) -> Series: ...

    def strip_chars_start(self, characters: IntoExpr = None) -> Series: ...

    def strip_chars_end(self, characters: IntoExpr = None) -> Series: ...

    def strip_prefix(self, prefix: IntoExpr) -> Series: ...

    def strip_suffix(self, suffix: IntoExpr) -> Series: ...

    def pad_start(self, length: int | IntoExprColumn, fill_char: str = " ") -> Series: ...

    def pad_end(self, length: int | IntoExprColumn, fill_char: str = " ") -> Series: ...

    def zfill(self, length: int | IntoExprColumn) -> Series: ...

    def to_lowercase(self) -> Series: ...

    def to_uppercase(self) -> Series: ...

    def to_titlecase(self) -> Series: ...

    def reverse(self) -> Series: ...

    def slice(self, offset: int | IntoExprColumn, length: int | IntoExprColumn | None = None) -> Series: ...

    def head(self, n: int | IntoExprColumn) -> Series: ...

    def tail(self, n: int | IntoExprColumn) -> Series: ...

    def to_integer(self, *, base: int | IntoExprColumn = 10, dtype: PolarsIntegerType = ..., strict: bool = True) -> Series: ...

    def contains_any(self, patterns: Series | list[str], *, ascii_case_insensitive: bool = False) -> Series: ...

    def replace_many(self, patterns: Series | list[str] | Mapping[str, str], replace_with: Series | list[str] | str | NoDefault = ..., *, ascii_case_insensitive: bool = False, leftmost: bool = False) -> Series: ...

    @unstable()
    def extract_many(self, patterns: Series | list[str], *, ascii_case_insensitive: bool = False, overlapping: bool = False, leftmost: bool = False) -> Series: ...

    @unstable()
    def find_many(self, patterns: IntoExpr, *, ascii_case_insensitive: bool = False, overlapping: bool = False, leftmost: bool = False) -> Series: ...

    def join(self, delimiter: str = "", *, ignore_nulls: bool = True) -> Series: ...

    def escape_regex(self) -> Series: ...

    def normalize(self, form: UnicodeForm = "NFC") -> Series: ...
