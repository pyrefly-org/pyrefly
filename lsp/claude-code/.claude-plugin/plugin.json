{
  "name": "pyrefly-lsp",
  "description": "Python language server (Pyrefly) for type checking and code intelligence",
  "version": "1.0.0",
  "author": {
    "name": "Meta"
  },
  "homepage": "https://pyrefly.org/en/docs/IDE/",
  "repository": "https://github.com/pyrefly-org/pyrefly",
  "license": "MIT",
  "lspServers": {
    "pyrefly": {
      "command": "pyrefly",
      "args": ["lsp"],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    }
  }
}
